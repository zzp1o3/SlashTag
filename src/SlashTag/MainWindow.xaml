<Window x:Class="SlashTag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlashTag.Views"
        xmlns:util="clr-namespace:SlashTag.Util;assembly=SlashTag.Core"
        Title="SlashTag"
        Width="340" Height="560"
        MinWidth="300" MinHeight="400"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Closing="Window_Closing" Loaded="Window_Loaded">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>

    <PathGeometry x:Key="PinGeometry"
                  Figures="M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" />

    <Style x:Key="RowDeleteButton" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                     Value="True">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PixelProgressBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="2" />
      <Setter Property="Background" Value="{StaticResource CellOffBrush}" />
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ActiveTaskTemplate">
      <Border x:Name="Row" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,0,2">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter Property="Background" Value="#1FFF6FB5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Rectangle Width="3" HorizontalAlignment="Left"
                     Fill="{StaticResource MagentaBrush}">
            <Rectangle.Style>
              <Style TargetType="Rectangle">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Rectangle.Style>
          </Rectangle>

          <Grid Margin="9,6,4,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="15" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" Style="{StaticResource PixelCheckBox}"
                      AutomationProperties.Name="{Binding Title, StringFormat=完成任务：{0}}"
                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                      Click="TaskCheck_Click" VerticalAlignment="Top" Margin="0,2,0,0"
                      ToolTip="{Binding [CheckTooltip], Source={x:Static util:Loc.Instance}}" />

            <StackPanel Grid.Column="1" Margin="7,0,6,0">
              <TextBlock Text="{Binding Title}"
                         FontSize="14" TextWrapping="Wrap"
                         MouseLeftButtonDown="TaskTitle_MouseLeftButtonDown"
                         Cursor="Hand"
                         ToolTip="{Binding [EditTooltip], Source={x:Static util:Loc.Instance}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding TimeText}"
                         Visibility="{Binding HasTimeText, Converter={StaticResource BoolToVis}}"
                         Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                         Margin="0,2,0,0" />
              <TextBlock Text="{Binding OverdueText}"
                         Visibility="{Binding HasOverdueText, Converter={StaticResource BoolToVis}}"
                         Foreground="{StaticResource MagentaBrush}" FontSize="10.5"
                         FontWeight="Bold" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,4,0">
              <Border BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" Padding="3,0"
                      Margin="0,0,4,0"
                      Visibility="{Binding IsCounted, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProgressText}" FontFamily="Courier New" FontSize="8.5"
                           Foreground="{StaticResource CyanBrush}" />
              </Border>
              <Border BorderBrush="{StaticResource YellowBrush}" BorderThickness="1" Padding="3,0"
                      Visibility="{Binding ShowTag, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding [LongTag], Source={x:Static util:Loc.Instance}}"
                           FontFamily="Courier New" FontSize="8.5"
                           Foreground="{StaticResource YellowBrush}" />
              </Border>
            </StackPanel>

            <Button Grid.Column="3" Content="×" Style="{StaticResource RowDeleteButton}"
                    AutomationProperties.Name="{Binding Title, StringFormat=删除任务：{0}}"
                    Click="DeleteTask_Click"
                    ToolTip="{Binding [DeleteTooltip], Source={x:Static util:Loc.Instance}}" />
          </Grid>

          <ProgressBar Style="{StaticResource PixelProgressBar}" Minimum="0" Maximum="1"
                       Value="{Binding ProgressRatio, Mode=OneWay}"
                       VerticalAlignment="Bottom" Height="2" IsHitTestVisible="False"
                       Visibility="{Binding IsCounted, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ClearedTaskTemplate">
      <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="9,5,4,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0" Style="{StaticResource PixelCheckBox}"
                    AutomationProperties.Name="{Binding Title, StringFormat=撤销完成：{0}}"
                    IsChecked="True" Click="ClearedCheck_Click"
                    VerticalAlignment="Top" Margin="0,1,0,0"
                    ToolTip="{Binding [UndoTooltip], Source={x:Static util:Loc.Instance}}" />

          <StackPanel Grid.Column="1" Margin="7,0,0,0">
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource DimBrush}"
                       FontSize="13" TextDecorations="Strikethrough" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="0,2,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WasLate}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <!-- 像素外壳：深色描边 + 黄色边框 + 网格底 -->
  <Border x:Name="RootShell" Background="{StaticResource BgBrush}" Padding="3">
    <Grid>
      <Border x:Name="NoteShell" Background="{StaticResource YellowBrush}" Padding="3">
        <Border Background="{StaticResource PanelGridBrush}">
          <Grid x:Name="Shell">
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题条（拖动区） -->
            <Border Grid.Row="0" Background="{StaticResource YellowBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
              <Grid Margin="10,0,4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                  <Button x:Name="BackButton" Style="{StaticResource PixelIconButton}"
                          Content="←" FontFamily="Segoe UI Symbol" FontSize="13"
                          AutomationProperties.Name="Back"
                          ToolTip="{Binding [BackTooltip], Source={x:Static util:Loc.Instance}}"
                          Visibility="Collapsed" Click="Back_Click" />
                  <TextBlock x:Name="TitleText" Text="QUEST LOG" FontFamily="Courier New" FontSize="11"
                             FontWeight="Bold" Foreground="{StaticResource BgBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Button x:Name="PinButton" Style="{StaticResource PixelIconButton}"
                          AutomationProperties.Name="Pin"
                          ToolTip="{Binding [PinOffTip], Source={x:Static util:Loc.Instance}}"
                          Click="Pin_Click">
                    <Viewbox Width="13" Height="13">
                      <Grid Width="24" Height="24">
                        <Path x:Name="PinFill" Data="{StaticResource PinGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Path Data="{StaticResource PinGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" />
                      </Grid>
                    </Viewbox>
                  </Button>
                  <Button x:Name="HeaderAddButton" Style="{StaticResource PixelIconButton}" Content="+"
                          AutomationProperties.Name="New task"
                          ToolTip="{Binding [NewTaskTooltip], Source={x:Static util:Loc.Instance}}"
                          Click="QuickAdd_Click" />
                  <Button x:Name="HeaderSettingsButton" Style="{StaticResource PixelIconButton}" Content="⚙"
                          AutomationProperties.Name="Settings"
                          FontFamily="Segoe UI Symbol"
                          ToolTip="{Binding [SettingsTooltip], Source={x:Static util:Loc.Instance}}"
                          Click="Settings_Click" />
                  <Button Style="{StaticResource PixelIconButton}" Content="×"
                          AutomationProperties.Name="Hide to tray"
                          ToolTip="{Binding [HideTooltip], Source={x:Static util:Loc.Instance}}"
                          Click="Hide_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- 日期 / 等级 -->
            <TextBlock Grid.Row="1" Text="{Binding DayText}" Margin="12,9,12,0"
                       FontFamily="Courier New" FontSize="10"
                       Foreground="{StaticResource MutedBrush}" />

            <!-- 今日经验 -->
            <Grid Grid.Row="2" Margin="12,7,12,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{Binding [Today], Source={x:Static util:Loc.Instance}}"
                         FontFamily="Courier New" FontSize="9"
                         Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />

              <ItemsControl Grid.Column="1" ItemsSource="{Binding XpCells}"
                            VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="10" Height="8" Margin="0,0,3,0"
                            BorderBrush="{StaticResource BgBrush}" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource CellOffBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding On}" Value="True">
                              <Setter Property="Background" Value="{StaticResource CyanBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Grid.Column="2" Text="{Binding XpText}"
                         FontFamily="Courier New" FontSize="9"
                         Foreground="{StaticResource YellowBrush}"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- 任务区 -->
            <ScrollViewer x:Name="TaskScroll" Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
              <StackPanel Margin="10,0" HorizontalAlignment="Stretch">

                <ItemsControl x:Name="ActiveList" ItemsSource="{Binding ActiveTasks}"
                              ItemTemplate="{StaticResource ActiveTaskTemplate}" />

                <TextBlock Text="{Binding [NoQuests], Source={x:Static util:Loc.Instance}}"
                           Margin="6,18,6,10"
                           FontFamily="Courier New" FontSize="10"
                           Foreground="{StaticResource DimBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveTasks}" Value="False">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <Button x:Name="ClearedToggle" Content="{Binding ClearedHeader}"
                        AutomationProperties.Name="今日已完成"
                        Style="{StaticResource PixelLinkButton}"
                        HorizontalAlignment="Left" Margin="0,2,0,0"
                        Click="ClearedToggle_Click"
                        Visibility="{Binding HasCleared, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding ClearedTasks}"
                              ItemTemplate="{StaticResource ClearedTaskTemplate}"
                              Visibility="{Binding ShowClearedList, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </ScrollViewer>

            <!-- 新建任务 -->
            <Grid Grid.Row="4" Height="34" Margin="10,6,10,0">
              <Button x:Name="AddButton" Style="{StaticResource PixelPrimaryButton}"
                      AutomationProperties.Name="新建任务"
                      Content="{Binding [AddQuest], Source={x:Static util:Loc.Instance}}"
                      Click="AddButton_Click" />

              <Grid x:Name="QuickAddPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&gt;" Foreground="{StaticResource YellowBrush}"
                           FontFamily="Courier New" FontSize="14"
                           VerticalAlignment="Center" Margin="8,0,6,0" />

                <Grid Grid.Column="1">
                  <TextBox x:Name="QuickAddBox" Style="{StaticResource PixelTextBox}"
                           AutomationProperties.Name="新任务标题"
                           KeyDown="QuickAddBox_KeyDown" FontSize="13"
                           VerticalContentAlignment="Center" />
                  <TextBlock Text="{Binding [QuickAddPlaceholder], Source={x:Static util:Loc.Instance}}"
                             Foreground="{StaticResource DimBrush}" FontSize="11.5"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=QuickAddBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <Button Grid.Column="2" Style="{StaticResource PixelIconButton}"
                        AutomationProperties.Name="完整编辑"
                        Content="⚙" FontFamily="Segoe UI Symbol"
                        Foreground="{StaticResource CyanBrush}"
                        ToolTip="{Binding [FullEditTooltip], Source={x:Static util:Loc.Instance}}"
                        Click="QuickAddDetail_Click" Margin="4,0,0,0" />
              </Grid>
            </Grid>

            <!-- 状态 -->
            <Grid Grid.Row="5" Margin="12,4,12,9">
              <Button Content="{Binding [History], Source={x:Static util:Loc.Instance}}"
                      AutomationProperties.Name="History"
                      Style="{StaticResource PixelLinkButton}"
                      HorizontalAlignment="Left" Click="History_Click" />
              <TextBlock Text="{Binding AlertText}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" FontFamily="Courier New"
                         FontSize="9.5" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAlert}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>

            <!-- 便签内页面：历史 / 设置 / 编辑器 -->
            <Grid x:Name="PageHost" Grid.Row="1" Grid.RowSpan="5"
                  Background="{StaticResource PanelGridBrush}" Visibility="Collapsed">
              <views:HistoryPage x:Name="HistoryPage" Visibility="Collapsed" />
              <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
              <views:TaskEditorPage x:Name="EditorPage" Visibility="Collapsed" />
            </Grid>

            <!-- 动效层：不参与布局与命中测试 -->
            <Canvas x:Name="EffectLayer" Grid.RowSpan="6" Panel.ZIndex="50"
                    IsHitTestVisible="False" ClipToBounds="True" />
          </Grid>
        </Border>
      </Border>

      <!-- 收起/展开动画层 -->
      <Canvas x:Name="TransitionLayer" Panel.ZIndex="200"
              IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
  </Border>
</Window>
