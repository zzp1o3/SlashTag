<Window x:Class="SlashTag.Views.EdgeIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlashTag Edge" Width="18" Height="44"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource YellowBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseEnter="Window_MouseEnter">

  <Border x:Name="Root" BorderBrush="{StaticResource BgBrush}" BorderThickness="2"
          Background="{StaticResource YellowBrush}"
          RenderTransformOrigin="0.5,0.5">
    <TextBlock Text="!" FontFamily="Courier New" FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource BgBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>
</Window>
