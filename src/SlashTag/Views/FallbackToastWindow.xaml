<Window x:Class="SlashTag.Views.FallbackToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:SlashTag.Util;assembly=SlashTag.Core"
        Title="SlashTag" Width="340" Height="104"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Border MouseLeftButtonDown="Root_MouseLeftButtonDown" Cursor="Hand"
          Background="{StaticResource BgBrush}" Padding="3">
    <Border Background="{StaticResource YellowBrush}" Padding="3">
      <Border Background="{StaticResource PanelGridBrush}" Padding="12,9">
          <StackPanel>
            <TextBlock Text="{Binding [ToastDue], Source={x:Static util:Loc.Instance}}"
                       FontFamily="Courier New" FontSize="9"
                       FontWeight="Bold" Foreground="{StaticResource MagentaBrush}" />
            <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource YellowBrush}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BodyText" FontSize="11"
                       Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Border>
    </Border>
</Window>
