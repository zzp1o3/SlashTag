<UserControl x:Class="SlashTag.Views.TaskEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:SlashTag.Util;assembly=SlashTag.Core"
             FontFamily="Microsoft YaHei UI">

  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{Binding [TitleLabel], Source={x:Static util:Loc.Instance}}"
                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
        <TextBox x:Name="TitleBox" Style="{StaticResource PixelTextBox}" Height="32" Margin="0,4,0,0"
                 AutomationProperties.Name="Title" />

        <TextBlock Text="{Binding [StartLabel], Source={x:Static util:Loc.Instance}}"
                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
        <TextBox x:Name="StartBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
                 AutomationProperties.Name="Start time" />
        <TextBlock Text="{Binding [StartHint], Source={x:Static util:Loc.Instance}}"
                   FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{Binding [DueLabel], Source={x:Static util:Loc.Instance}}"
                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
        <TextBox x:Name="DueBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
                 AutomationProperties.Name="Due time" />
        <TextBlock Text="{Binding [DueHint], Source={x:Static util:Loc.Instance}}"
                   FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="LongTermBox" Style="{StaticResource PixelCheckBox}"
                  AutomationProperties.Name="Long-term"
                  Content="{Binding [LongTermOption], Source={x:Static util:Loc.Instance}}"
                  Margin="0,12,0,0" />

        <TextBlock Text="{Binding [CountLabel], Source={x:Static util:Loc.Instance}}"
                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
        <TextBox x:Name="CountBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
                 Text="1" AutomationProperties.Name="Target count" />
        <TextBlock Text="{Binding [CountHint], Source={x:Static util:Loc.Instance}}"
                   FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource MagentaBrush}"
                   FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{Binding [Cancel], Source={x:Static util:Loc.Instance}}"
              Style="{StaticResource PixelSecondaryButton}" Width="76" Click="Cancel_Click" />
      <Button Content="{Binding [Save], Source={x:Static util:Loc.Instance}}"
              Style="{StaticResource PixelPrimaryButton}" Width="76"
              Margin="8,0,0,0" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</UserControl>
