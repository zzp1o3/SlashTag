<UserControl x:Class="SlashTag.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:SlashTag.Util;assembly=SlashTag.Core"
             FontFamily="Microsoft YaHei UI">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12,14,12">
      <TextBlock Text="{Binding [LanguageLabel], Source={x:Static util:Loc.Instance}}"
                 FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="ChineseButton" Content="中文" Width="80"
                Style="{StaticResource PixelSecondaryButton}" Click="Chinese_Click" />
        <Button x:Name="EnglishButton" Content="English" Width="96" Margin="8,0,0,0"
                Style="{StaticResource PixelSecondaryButton}" Click="English_Click" />
      </StackPanel>

      <TextBlock Text="{Binding [StartupLabel], Source={x:Static util:Loc.Instance}}"
                 FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" />
      <CheckBox x:Name="AutostartBox" Style="{StaticResource PixelCheckBox}"
                Content="{Binding [Autostart], Source={x:Static util:Loc.Instance}}"
                Margin="0,8,0,0" Click="Autostart_Click" />

      <TextBlock Text="{Binding [DataFileLabel], Source={x:Static util:Loc.Instance}}"
                 FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" />
      <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource CyanBrush}"
              BorderThickness="2" Padding="7,5" Margin="0,4,0,0">
        <TextBlock x:Name="DataPathText" FontSize="10.5" Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap" />
      </Border>
      <Button Content="{Binding [OpenDataFolder], Source={x:Static util:Loc.Instance}}"
              Style="{StaticResource PixelSecondaryButton}"
              HorizontalAlignment="Left" Width="140" Margin="0,8,0,0"
              Click="OpenFolder_Click" />

      <TextBlock x:Name="ErrorText" Foreground="{StaticResource MagentaBrush}" FontSize="11"
                 Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0"
              Padding="0,10,0,0">
        <StackPanel>
          <TextBlock Text="{Binding [DataNote], Source={x:Static util:Loc.Instance}}"
                     FontSize="10" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="VersionText" FontFamily="Courier New" FontSize="9"
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
