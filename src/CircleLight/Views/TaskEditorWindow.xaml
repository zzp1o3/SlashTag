<controls:PixelWindow x:Class="CircleLight.Views.TaskEditorWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:CircleLight.Controls"
                     Title="NEW QUEST" Width="380" SizeToContent="Height">

  <StackPanel>
    <TextBlock Text="任务标题" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
    <TextBox x:Name="TitleBox" Style="{StaticResource PixelTextBox}" Height="32" Margin="0,4,0,0"
             AutomationProperties.Name="任务标题" />

    <TextBlock Text="开始时间（可选）" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
    <TextBox x:Name="StartBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
             AutomationProperties.Name="开始时间" />
    <TextBlock Text="留空不提醒。只填 19:30 表示今天；也可填 2026-11-03 19:30。"
               FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />

    <TextBlock Text="截止时间（可选）" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
    <TextBox x:Name="DueBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
             AutomationProperties.Name="截止时间" />
    <TextBlock Text="到点未勾选会提醒一次；完成时会记录超时时长。"
               FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />

    <CheckBox x:Name="LongTermBox" Style="{StaticResource PixelCheckBox}"
              AutomationProperties.Name="长期待办"
              Content="长期待办 · 完成后保留在列表" Margin="0,16,0,0" />

    <TextBlock Text="目标次数（可选）" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
    <TextBox x:Name="CountBox" Style="{StaticResource PixelTextBox}" Height="30" Margin="0,4,0,0"
             Text="1" AutomationProperties.Name="目标次数" />
    <TextBlock Text="1 = 普通任务；大于 1 表示每天做满这么多次，达标才记完成，次日清零。"
               FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource MagentaBrush}"
               FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Style="{StaticResource PixelSecondaryButton}" Width="76"
              Click="Cancel_Click" />
      <Button Content="保存" Style="{StaticResource PixelPrimaryButton}" Width="76"
              Margin="8,0,0,0" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</controls:PixelWindow>
