<controls:PixelWindow x:Class="CircleLight.Views.HistoryWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:CircleLight.Controls"
                     Title="QUEST HISTORY" Width="420" Height="580">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,16">
                <Grid Margin="0,0,0,5">
                  <TextBlock Text="{Binding Header}" FontFamily="Courier New" FontSize="10"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding Count}" HorizontalAlignment="Right"
                             FontFamily="Courier New" FontSize="9"
                             Foreground="{StaticResource YellowBrush}" />
                </Grid>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Time}" FontFamily="Courier New" FontSize="9.5"
                                   Foreground="{StaticResource DimBrush}" Margin="0,1,8,0" />

                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Top" Margin="8,0,0,0">
                          <Border BorderBrush="{StaticResource CyanBrush}" BorderThickness="1"
                                  Padding="3,0" Margin="0,0,6,0"
                                  Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Progress}" FontFamily="Courier New" FontSize="7.5"
                                       Foreground="{StaticResource CyanBrush}" />
                          </Border>
                          <Border BorderBrush="{StaticResource YellowBrush}" BorderThickness="1"
                                  Padding="3,0" Margin="0,0,6,0"
                                  Visibility="{Binding IsLongTerm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LONG" FontFamily="Courier New" FontSize="7.5"
                                       Foreground="{StaticResource YellowBrush}" />
                          </Border>
                          <TextBlock Text="{Binding Overdue}" FontSize="9.5" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsLate}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="NO RECORDS YET" Margin="0,24,0,0" FontFamily="Courier New"
                   FontSize="10" Foreground="{StaticResource DimBrush}"
                   Visibility="{Binding HasDays, Converter={StaticResource InvBoolToVis}}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <TextBlock Text="{Binding TotalText}" FontFamily="Courier New" FontSize="9.5"
                 Foreground="{StaticResource YellowBrush}" />
    </Border>
  </Grid>
</controls:PixelWindow>
